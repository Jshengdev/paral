  "v": 1,
  "id": "the-way-to-it",
  "title": "The deadline is not in view: it shows which way to scroll, down from the top and up from far below, until the line is found",
  "criteria": ["C18", "C6"],
  "page": "real:rso-recognition",
  "source": { "url": "https://campusactivities.usc.edu/programs/recognized-student-organizations/rso-recognition-process/" },
  "others": {
