  },
  "steps": [
    { "look": true, "waitMs": 12000,
      "expect": { "shows": true, "spoken": true, "says": ["November 22"], "way": { "to": "down", "toward": "Deadlines" } } },
    { "look": true, "page": "real:rso-far-below", "waitMs": 8000,
      "expect": { "shows": true, "way": { "to": "up", "toward": "Deadlines" } } },
    { "look": true, "page": "real:rso-deadlines", "waitMs": 8000,
      "expect": { "shows": true, "mark": { "on": "November 22 at 11:59pm:" }, "countsDaysTo": "November 22" } },
    { "say": "How long do I have?", "circle": null,
      "expect": { "plain": true, "sentences": 1, "countsDaysTo": "November 22" } }
  ]
}
