#!/bin/sh
# ./run          the first look: says which grants paral needs, then builds, signs and starts the mind and the app
# ./run build    builds and signs tmp/Paral.app and starts nothing; a running paral is ended first, as below
# ./run grants   only says which grants paral needs
# ./run stop     ends the mind and the app
# PARAL_KEYS names the key file (default ~/.config/paral/keys.env). PARAL_SIGN=- signs without an identity.
cd "$(dirname "$0")" || exit 1
app=tmp/Paral.app
keys="${PARAL_KEYS:-$HOME/.config/paral/keys.env}"
mkdir -p tmp

stop() {
  pkill -f "$app/Contents/MacOS/paral" 2>/dev/null
  [ -f tmp/mind.pid ] && kill "$(cat tmp/mind.pid)" 2>/dev/null
  rm -f tmp/mind.pid
}

setting() { node -e "import('./mind/settings.ts').then((m) => console.log(m.settings.$1.value))"; }

grants() {
  cat <<TEXT
paral needs two grants from macOS, and asks for both the first time it starts:

  1. Microphone. A system box appears. paral listens only while the key is held.
  2. Screen & System Audio Recording. System Settings opens; switch paral on there, then start it again with
     ./run (macOS applies this grant only to a fresh start).

It asks for no Input Monitoring grant: the key is read by asking the system which keys are down.

  3. Accessibility, only if you ask it to scroll for you ("Scroll for me") or to open a closed section it has boxed
     ("Open it for me"). macOS shows its own box the first time; switch paral on under Privacy & Security,
     Accessibility, then ask again. Without it paral never scrolls or clicks, and says so. Everything else works
     without it.
To check that the key is seen on this Mac before starting:  body/.build/debug/paral-headless keys 10 $1

On each ask, with the live services, this leaves the Mac: the sound of the question (to the ear); the text read
off the whole screen and your words so far, while you hold the key (to the fast model, which writes the quick
line); one scaled picture of the main display with the lines read from it and the question (to the deep model,
which writes the answer); and each sentence said (to the voice). When you draw around something, the answer is
made from only that part of the picture and the lines in it; the quick line has still read the text of the
whole screen. Close private windows first.

To use it: hold $1, ask out loud, let go. Hold $2 as well and move the pointer to draw around something.
The "paral" item in the menu bar closes a conversation or quits; so does the cross on the resting circle.
TEXT
}

case "${1:-}" in
  stop) stop; echo "paral stopped"; exit 0 ;;
  ""|build|grants) ;;
  *) echo "usage: ./run | ./run build | ./run grants | ./run stop" >&2; exit 2 ;;
esac

key=$(setting holdKey) && pen=$(setting drawKey) && socket=$(setting socketPath) || exit 1
if [ "${1:-}" = grants ]; then grants "$key" "$pen"; exit 0; fi

echo "run: building the app"
(cd body && swift build -c release 2>&1 | tail -1 | grep -q "Build complete") || { echo "run: the body did not build; run (cd body && swift build -c release) to see why" >&2; exit 1; }
# A running paral is ended before its file is replaced, so no app is left running from a file that is gone. This does
# not keep macOS's box away (the one that asks to allow the app to see the screen): that box comes when a running app
# is stopped while one of its looks is on its way, at any stop (notes/2026-11-15.md).
if pgrep -f "$app/Contents/MacOS/paral" >/dev/null 2>&1; then
  stop
  tries=0
  while pgrep -f "$app/Contents/MacOS/paral" >/dev/null 2>&1 && [ "$tries" -lt 60 ]; do sleep 0.05; tries=$((tries + 1)); done
  [ "${1:-}" = build ] && echo "run: the paral that was running is stopped, so its file can be replaced"
fi
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp body/.build/release/paral "$app/Contents/MacOS/paral"
cp body/tokens.json "$app/Contents/Resources/tokens.json"
# The app's icon: what Finder and the grants in System Settings show beside its name. The app starts without it too.
cp body/AppIcon.icns "$app/Contents/Resources/AppIcon.icns" || echo "run: the app's icon could not be copied; the app starts without it" >&2
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>dev.paral.body</string>
  <key>CFBundleName</key><string>paral</string>
  <key>CFBundleExecutable</key><string>paral</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSMicrophoneUsageDescription</key><string>paral listens only while you hold its key, to hear your question.</string>
  <key>ParalSocket</key><string>$socket</string>
  <key>ParalTokens</key><string>$PWD/body/tokens.json</string>
</dict></plist>
PLIST
identity="${PARAL_SIGN:-$(security find-identity -v -p codesigning | awk 'NR==1 && $2 ~ /^[0-9A-F]+$/ {print $2}')}"
if [ -z "$identity" ]; then
  identity=-
  echo "run: no code-signing identity on this Mac, so macOS will ask for the screen grant again after every rebuild" >&2
fi
[ "$identity" = - ] || echo "run: signing the app with this Mac's code-signing identity; if a box asks for your login password, type it and choose Always Allow"
signed=$(codesign --force --sign "$identity" "$app" 2>&1) || { echo "run: signing failed ($signed); PARAL_SIGN=- ./run signs without an identity" >&2; exit 1; }

if [ "${1:-}" = build ]; then echo "built and signed $app; nothing was started"; exit 0; fi

grants "$key" "$pen"
[ -f "$keys" ] || echo "run: no key file at $keys, so the mind answers from the tape (recorded answers); see keys.env.example" >&2
stop
node --env-file-if-exists="$keys" mind/main.ts > tmp/mind.log 2>&1 &
echo $! > tmp/mind.pid
tries=0
while [ ! -S "$socket" ] && [ "$tries" -lt 100 ]; do sleep 0.05; tries=$((tries + 1)); done
[ -S "$socket" ] || { echo "run: the mind did not start; see tmp/mind.log" >&2; stop; exit 1; }
open "$app"
echo
echo "paral is starting. The mind's log is tmp/mind.log. ./run stop ends it."
